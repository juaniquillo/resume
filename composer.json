{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "juaniquillo/resume",
    "type": "project",
    "description": "A professional resume management system built with Laravel, Livewire, and CrudAssistant.",
    "keywords": [
        "resume",
        "cv",
        "portfolio",
        "laravel",
        "livewire",
        "crud-assistant"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "juaniquillo/crud-assistant": "^0.2.0",
        "juaniquillo/flux-backend-components": "^0.2.4",
        "juaniquillo/input-component-action": "dev-main",
        "juaniquillo/laravel-backend-component": "^0.10.0",
        "juststeveking/resume-php": "^1.0",
        "laravel/fortify": "^1.41.0",
        "laravel/framework": "^13.38",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "livewire/blaze": "^1.0.19",
        "livewire/flux": "^2.21.0",
        "livewire/livewire": "^4.4.8",
        "spatie/browsershot": "^5.4.1",
        "spatie/laravel-pdf": "^2.14",
        "spatie/laravel-screenshot": "^1.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.4",
        "larastan/larastan": "^3.13.1",
        "laravel/boost": ">=2.10.3",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "phpstan/phpstan": "^2.3.1",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "rector": [
            "vendor/bin/rector process"
        ],
        "rector:dry-run": [
            "vendor/bin/rector process --dry-run"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "analyse": "@composer run phpstan",
        "phpstan": "vendor/bin/phpstan --memory-limit=1G",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "qa": [
            "@php artisan config:clear --ansi",
            "@composer rector",
            "@composer lint",
            "@composer phpstan",
            "@php artisan test --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
